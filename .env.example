# ============================================================================
# Supabase (público — usado no cliente e validação de sessão no servidor)
# ============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================================================
# Inteligência Artificial (SECRETAS — somente servidor; NUNCA use prefixo VITE_)
# Todos os provedores abaixo são opcionais: o servidor monta automaticamente
# a fila de fallback com os provedores que tiverem chave preenchida.
# ============================================================================

# Ordem de prioridade dos provedores (padrão: groq,gemini,openrouter)
AI_PROVIDER_ORDER=groq,gemini,openrouter

# 1. Groq (OpenAI Vision compatível)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Modelos extras de fallback no Groq, separados por vírgula (opcional)
GROQ_FALLBACK_MODELS=

# 2. Google Gemini (com cascata rápida de modelos)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash

# 3. OpenRouter (modelos gratuitos com visão, separados por vírgula)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
